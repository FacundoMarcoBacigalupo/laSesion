NODE_ENV=development
PORT=3000
# URL pública del frontend. En Vercel: https://tu-proyecto.vercel.app
PUBLIC_URL=http://localhost:5173
# Vacío si el sitio y el socket salen del mismo deploy. Solo hace falta si el Node está en otro host.
VITE_API_URL=
TRUST_PROXY=1
ADMIN_PASSWORD=cambiame
JWT_SECRET=string-largo-aleatorio-cambiar-en-produccion
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_ENABLED=true
AI_HEARTBEAT_MS=9000
AI_MIN_GAP_MS=2500
AI_MAX_RPM=12
# Respuestas de modelo por rito. 5 sobrevivientes x 3 preguntas. Se reinicia con el rito.
AI_MAX_CALLS=15
AI_TIMEOUT_MS=7000
# Supabase PostgreSQL connection string (replace the placeholders with your project details)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
RETENTION_HOURS=24
LOG_LEVEL=info